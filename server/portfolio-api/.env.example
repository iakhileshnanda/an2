# AI Keys
API_KEY=your_kimi_k2_key_here
GROQ_API_KEY=your_groq_key_here

# Anthropic (recruiter "Maya" chat — claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_anthropic_key_here
RECRUITER_MODEL=claude-sonnet-4-6

# Admin live-edit mode — bearer token the dashboard sends with POST /api/update.
# The chat passphrase is UI-only; THIS is the real authority check. Keep it secret.
ADMIN_TOKEN=generate_a_long_random_string_here

# Optional: override where about-me.md lives (defaults to newakhilesh/about-me.md)
# ABOUT_ME_PATH=/home/ubuntu/apps/newakhilesh/about-me.md

# Resume
RESUME_URL=https://your-resume-pdf-link-here

# Server — V2 runs on 3002 to avoid conflict with production on 3001
PORT=3002
NODE_ENV=production

# CORS - your V2 portfolio domain
ALLOWED_ORIGIN=https://v2.akhileshnanda.maya-ai.dev
