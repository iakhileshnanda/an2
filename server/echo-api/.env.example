# --- Anthropic (Echo's brain) ---
# Required. Echo will not answer without it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model. Default is the most capable Opus. For snappier, cheaper replies on a
# chat companion, claude-sonnet-4-6 is a reasonable choice.
ECHO_MODEL=claude-opus-4-8

# --- Tools ---
# GitHub username Echo reports activity for. Only used as the fallback when no
# GITHUB_TOKEN is set (public repos only).
GITHUB_USERNAME=iakhileshnanda
# Token: when set, Echo authenticates to GitHub and reads PRIVATE repos too (via
# /user/repos for the token owner), and gets the higher rate limit. The token is
# only sent as an Authorization header — never returned in replies or logged.
# Use a classic PAT with `repo` scope, or a fine-grained token with repo read.
GITHUB_TOKEN=

# Optional: where the resume PDF lives. Injected into the resume tool's payload.
# RESUME_URL=https://your-resume-link

# --- Server ---
PORT=3005
NODE_ENV=development
# Comma-separated allowed origins for CORS. Empty = allow all (dev).
ALLOWED_ORIGINS=
